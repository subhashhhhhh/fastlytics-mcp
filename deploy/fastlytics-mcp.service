[Unit]
Description=Fastlytics MCP Server (Streamable HTTP)
After=network.target

[Service]
Type=simple
User=fastlytics
WorkingDirectory=/opt/fastlytics-mcp
ExecStart=/usr/bin/node /opt/fastlytics-mcp/dist/index.js
Restart=always
RestartSec=5
# Bound Node's V8 heap and the complete service to prevent a leak from exhausting the host.
Environment=NODE_OPTIONS=--max-old-space-size=768
MemoryHigh=768M
MemoryMax=1G
# Secrets (SUPABASE_JWT_SECRET for verifying HS256-signed OAuth tokens) live
# outside the repo, readable by root only (systemd reads it before dropping privileges).
EnvironmentFile=-/etc/fastlytics-mcp.env
Environment=TRANSPORT=http
Environment=HTTP_PORT=48500
Environment=FASTLYTICS_API_URL=https://fastlytics-api-proxy-v2.subhashgottumukkala17.workers.dev
# Optional: set a default API key (overridden per-request by Authorization header)
# Environment=FASTLYTICS_MCP_API_KEY=fl_mcp_...

[Install]
WantedBy=multi-user.target
