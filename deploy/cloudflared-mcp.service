[Unit]
Description=Cloudflare Tunnel for Fastlytics MCP
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/cloudflared --no-autoupdate --config /etc/cloudflared/fastlytics-mcp.yml tunnel run
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
