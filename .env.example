# Fastlytics MCP API key (required)
# Get yours from https://fastlytics.app/settings/api-keys
FASTLYTICS_MCP_API_KEY=fl_mcp_your_key_here

# Worker API URL (defaults to the production workers.dev endpoint if unset)
FASTLYTICS_API_URL=https://fastlytics-api-proxy-v2.subhashgottumukkala17.workers.dev

# Transport: "stdio" (default for Claude Desktop/Cursor) or "http" (for remote access)
TRANSPORT=stdio
HTTP_PORT=3456
